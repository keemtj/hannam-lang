{
  "name": "hannam-lang-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r build && changeset publish",
    "site:dev": "pnpm --filter @hannam-lang/site dev",
    "site:build": "pnpm --filter @hannam-lang/core build && pnpm --filter @hannam-lang/site build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
