{
  "name": "mzscript-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r build && changeset publish",
    "demo:build": "pnpm --filter @mzscript/core --filter @mzscript/vite-plugin build",
    "demo:server": "node packages/mzscript/bin/mz.js examples/todo/server/server.mz",
    "demo:web": "pnpm --filter @mzscript/example-todo-web dev",
    "demo": "pnpm demo:build && node examples/todo/demo.js",
    "site:dev": "pnpm --filter @mzscript/site dev",
    "site:build": "pnpm --filter @mzscript/core build && pnpm --filter @mzscript/site build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3"
  }
}
