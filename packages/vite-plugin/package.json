{
  "name": "@mzscript/vite-plugin",
  "version": "0.1.0",
  "description": "mzscript(.mz) 모듈을 Vite에서 쓰게 해 주는 플러그인",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemtj/mzscript.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/keemtj/mzscript#readme",
  "bugs": {
    "url": "https://github.com/keemtj/mzscript/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mzscript/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "ws": "8.22.0"
  }
}
