{
  "name": "hannam-lang-vscode",
  "displayName": "한남랭 (hannam-lang)",
  "description": "한남랭(.hn) 문법 하이라이팅, 스니펫, 컴파일 에러 표시",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemtj/hannam-lang.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/keemtj/hannam-lang#readme",
  "bugs": {
    "url": "https://github.com/keemtj/hannam-lang/issues"
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "publisher": "hannam-lang",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "hannam",
    "hannam-lang",
    "hn",
    "한남랭"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:hannam"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hannam",
        "aliases": [
          "hannam-lang",
          "hannam"
        ],
        "extensions": [
          ".hn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hannam",
        "scopeName": "source.hn",
        "path": "./syntaxes/hannam.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "hannam",
        "path": "./snippets/hannam.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm build && vsce package --no-dependencies --out dist/hannam-lang-vscode.vsix"
  },
  "devDependencies": {
    "@hannam-lang/core": "workspace:*",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
