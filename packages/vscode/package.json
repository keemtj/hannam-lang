{
  "name": "mzscript-vscode",
  "displayName": "엠지스크립트 (mzscript)",
  "description": "엠지스크립트(.mz) 문법 하이라이팅, 스니펫, 컴파일 에러 표시",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemtj/mzscript.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/keemtj/mzscript#readme",
  "bugs": {
    "url": "https://github.com/keemtj/mzscript/issues"
  },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "publisher": "mzscript",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "mzscript",
    "mzscript",
    "mz",
    "엠지스크립트"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:mzscript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mzscript",
        "aliases": [
          "mzscript",
          "mzscript"
        ],
        "extensions": [
          ".mz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mzscript",
        "scopeName": "source.mz",
        "path": "./syntaxes/mzscript.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.line.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "mzscript",
        "path": "./snippets/mzscript.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm build && vsce package --no-dependencies --out dist/mzscript-vscode.vsix"
  },
  "devDependencies": {
    "@mzscript/core": "workspace:*",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
