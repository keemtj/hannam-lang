{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"information_for_contributors": [
		"밈이 아닌 부분은 VS Code 내장 JavaScript 문법(source.js)이 그대로 칠한다.",
		"밈은 injections로 source.js 규칙 안 어디서든 끼어들고, 'L:' 우선순위로 같은 위치의 JS 규칙보다 먼저 맞춘다.",
		"문자열·주석·정규식(string.regexp도 string)은 selector에서 빼서 그 안의 밈 글자는 칠하지 않는다.",
		"템플릿 ${} 안에는 값 위치 밈만 칠한다. TextMate selector는 '가장 안쪽 scope'를 지정할 수 없어서 템플릿 중첩 깊이 3까지 selector를 풀어 썼다.",
		"패턴 순서는 명세의 '가장 긴 형태 우선' 규칙을 따른다 (같은 위치에서는 먼저 쓴 패턴이 이긴다)."
	],
	"name": "hannam-lang",
	"scopeName": "source.hn",
	"patterns": [
		{
			"include": "source.js"
		}
	],
	"injections": {
		"L:source.hn - string - comment": {
			"patterns": [
				{
					"include": "#value-memes"
				},
				{
					"include": "#statement-memes"
				}
			]
		},
		"L:source.hn meta.template.expression.js - (meta.template.expression.js string) - comment, L:source.hn meta.template.expression.js string meta.template.expression.js - (meta.template.expression.js string meta.template.expression.js string) - comment, L:source.hn meta.template.expression.js string meta.template.expression.js string meta.template.expression.js - (meta.template.expression.js string meta.template.expression.js string meta.template.expression.js string) - comment": {
			"patterns": [
				{
					"include": "#value-memes"
				}
			]
		}
	},
	"repository": {
		"value-memes": {
			"patterns": [
				{
					"comment": "confirm: 예? 무슨 발언이세요?(질문). 예???·예??·예?보다 길어서 먼저 맞춘다",
					"name": "support.function.confirm.hn",
					"match": "(?<![_$[:alnum:].])예\\?[ \\t]+무슨 발언이세요\\?(?!\\?)"
				},
				{
					"comment": "await: 티~원! 표현식. 티~원보다 길어서 먼저 맞춘다",
					"name": "keyword.control.flow.await.hn",
					"match": "(?<![_$[:alnum:].])티~원!"
				}
			]
		},
		"statement-memes": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#declaration"
				},
				{
					"include": "#conditional"
				},
				{
					"include": "#loop"
				},
				{
					"include": "#function"
				},
				{
					"include": "#try-catch"
				},
				{
					"include": "#class"
				},
				{
					"include": "#console-log"
				}
			]
		},
		"comment": {
			"comment": "엄... 내용 → // 주석. 줄 끝까지",
			"name": "comment.line.triple-dot.hn",
			"begin": "(?<![_$[:alnum:].])(엄\\.\\.\\.)(?=[ \\t]|$)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.comment.hn"
				}
			},
			"end": "(?=$)"
		},
		"declaration": {
			"comment": "엄 뒤에는 공백 + 식별자 또는 구조분해 패턴이 와야 선언이다 (엄.length, 엄 = 1, 엄마는 일반 JS)",
			"patterns": [
				{
					"name": "storage.type.const.hn",
					"match": "(?<![_$[:alnum:].])엄\\.\\.(?=[ \\t]+[_$[:alpha:]\\[{])"
				},
				{
					"name": "storage.type.let.hn",
					"match": "(?<![_$[:alnum:].])엄\\.(?=[ \\t]+[_$[:alpha:]\\[{])"
				},
				{
					"name": "storage.type.var.hn",
					"match": "(?<![_$[:alnum:].])엄(?=[ \\t]+[_$[:alpha:]\\[{])"
				}
			]
		},
		"conditional": {
			"patterns": [
				{
					"name": "keyword.control.conditional.switch.hn",
					"match": "(?<![_$[:alnum:].])예\\?\\?\\?(?!\\?)"
				},
				{
					"name": "keyword.control.conditional.else-if.hn",
					"match": "(?<![_$[:alnum:].])예\\?\\?(?!\\?)"
				},
				{
					"name": "keyword.control.conditional.if.hn",
					"match": "(?<![_$[:alnum:].])예\\?(?!\\?)"
				},
				{
					"comment": "else, 그리고 예??? 안의 default 갈래. 아뇨(continue)보다 길어서 먼저 맞춘다",
					"name": "keyword.control.conditional.else.hn",
					"match": "(?<![_$[:alnum:].])아뇨아뇨아뇨아뇨(?![_$[:alnum:]])"
				}
			]
		},
		"loop": {
			"patterns": [
				{
					"name": "keyword.control.loop.while.hn",
					"match": "(?<![_$[:alnum:].])요이이이~(?=\\s)"
				},
				{
					"name": "keyword.control.loop.for-of.hn",
					"match": "(?<![_$[:alnum:].])요이~(?=\\s)"
				},
				{
					"name": "keyword.control.loop.for-in.hn",
					"match": "(?<![_$[:alnum:].])요히~(?=\\s)"
				},
				{
					"name": "keyword.control.loop.continue.hn",
					"match": "(?<![_$[:alnum:].])아뇨(?![_$[:alnum:]])"
				}
			]
		},
		"function": {
			"patterns": [
				{
					"comment": "return. 줴줴이야(break)보다 길어서 먼저 맞춘다",
					"name": "keyword.control.flow.return.hn",
					"match": "(?<![_$[:alnum:].])아![ \\t]+줴줴이야~"
				},
				{
					"comment": "throw. 줴줴이야(break)보다 길어서 먼저 맞춘다",
					"name": "keyword.control.flow.throw.hn",
					"match": "(?<![_$[:alnum:].])아\\.\\.\\.[ \\t]+줴줴이야\\.\\.\\."
				},
				{
					"name": "keyword.control.loop.break.hn",
					"match": "(?<![_$[:alnum:].])줴줴이야(?![_$[:alnum:]~.])"
				},
				{
					"comment": "async function. 티~원!(await)은 value-memes가 먼저 맞춘다",
					"match": "(?<![_$[:alnum:].])(티~원)(?![!])(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?",
					"captures": {
						"1": {
							"name": "storage.type.function.async.hn"
						},
						"2": {
							"name": "entity.name.function.hn"
						}
					}
				},
				{
					"match": "(?<![_$[:alnum:].])(티-원)(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?",
					"captures": {
						"1": {
							"name": "storage.type.function.hn"
						},
						"2": {
							"name": "entity.name.function.hn"
						}
					}
				}
			]
		},
		"try-catch": {
			"patterns": [
				{
					"name": "keyword.control.trycatch.try.hn",
					"match": "(?<![_$[:alnum:].])진~지\\?"
				},
				{
					"name": "keyword.control.trycatch.catch.hn",
					"match": "(?<![_$[:alnum:].])지~랄"
				}
			]
		},
		"class": {
			"patterns": [
				{
					"match": "(?<![_$[:alnum:].])(오호호호홋~)(?=\\s)(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*)(?=[ \\t]*\\{))?",
					"captures": {
						"1": {
							"name": "storage.type.class.extends.hn"
						},
						"2": {
							"name": "entity.name.type.class.hn"
						},
						"3": {
							"name": "entity.other.inherited-class.hn"
						}
					}
				},
				{
					"match": "(?<![_$[:alnum:].])(오호호호호~)(?=\\s)(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?",
					"captures": {
						"1": {
							"name": "storage.type.class.hn"
						},
						"2": {
							"name": "entity.name.type.class.hn"
						}
					}
				}
			]
		},
		"console-log": {
			"name": "support.function.console.log.hn",
			"match": "(?<![_$[:alnum:].])무슨 발언이세요\\?(?!\\?)"
		}
	}
}
