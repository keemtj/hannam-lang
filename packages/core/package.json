{
  "name": "@mzscript/core",
  "version": "0.1.0",
  "description": "mzscript(.mz) → JavaScript 변환기",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemtj/mzscript.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/keemtj/mzscript#readme",
  "bugs": {
    "url": "https://github.com/keemtj/mzscript/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "magic-string": "1.4.3"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@types/node": "22.20.5",
    "acorn": "8.19.0",
    "lodash-es": "4.17.21",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
