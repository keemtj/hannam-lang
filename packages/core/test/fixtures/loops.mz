요이~ 할일 할일들 {
  예? 할일.완료 {
    아뇨
  }
  무슨 발언이세요? 할일.내용
}

요이~ i 0..할일들.length {
  무슨 발언이세요? `${i + 1}. ${할일들[i].내용}`
}

요이~ i 1.5..3 {
  줴줴이야
}

요히~ 키 설정 {
  무슨 발언이세요? `${키}: ${설정[키]}`
}

요이~ [키, 값] Object.entries(설정) {
  무슨 발언이세요? `${키}=${값}`
}

요이~ { 내용 } 할일들 {
  무슨 발언이세요? 내용
}

요이~ x [...앞, ...뒤] {
  무슨 발언이세요? x
}

엄. 남은수 = 3
요이이이~ 남은수 > 0 {
  남은수--
}
