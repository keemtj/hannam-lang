티-원 할일추가(내용) {
  예? !내용.trim() {
    아... 줴줴이야... "빈 할 일"
  }
  할일들.push({ id: Date.now(), 내용, 완료: false })
  아! 줴줴이야~ 할일들.length
}

티-원 삭제(id) {
  예? !id {
    아! 줴줴이야~
  }
  할일들.splice(할일들.findIndex(할일 => 할일.id === id), 1)
}

티~원 불러오기(url) {
  엄.. 응답 = 티~원! fetch(url)
  예? !응답.ok {
    아... 줴줴이야... `불러오기 실패 (${응답.status})`
  }
  아! 줴줴이야~ 티~원! 응답.json()
}

티-원 던지기(에러) {
  예? 에러 instanceof 검증에러 {
    아... 줴줴이야... new 검증에러("검증 실패")
  }
  아... 줴줴이야... 에러
}

티-원 객체돌려주기() {
  아! 줴줴이야~ { ok: true }
}

export 티-원 내보내기() {}
export default 티~원 기본() {}
