    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
